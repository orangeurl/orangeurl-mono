# Caddy / TLS
DOMAIN=orangeurl.live
ACME_EMAIL=admin@orangeurl.live

# Public hostnames the web/api see (used inside containers + for CSP)
PUBLIC_HOST=api.orangeurl.live
PUBLIC_DOMAIN=https://orangeurl.live
NEXT_PUBLIC_API_URL=https://api.orangeurl.live
NEXT_PUBLIC_APP_URL=https://app.orangeurl.live
BACKEND_URL=http://api:3000/api/v1

# Go API
APP_PORT=:3000
API_QUOTA=100
GEOIP_DB_PATH=/app/geo-data

# Postgres
POSTGRES_USER=orangeurl
POSTGRES_PASSWORD=changeme
POSTGRES_DB=orangeurl
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_JWKS_URL=
CLERK_WEBHOOK_SECRET=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# DodoPayments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_WEBHOOK_SECRET=
DODO_PREMIUM_MONTHLY_PRODUCT_ID=
DODO_PREMIUM_ANNUAL_PRODUCT_ID=
DODO_PRO_MONTHLY_PRODUCT_ID=
DODO_PRO_ANNUAL_PRODUCT_ID=

# Gemini (AI suggestions)
GEMINI_API_KEY=
