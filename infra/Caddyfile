{
  email {$ACME_EMAIL:admin@orangeurl.live}
}

# Shared security-header snippets. Defined once, applied per-site below so we
# can keep X-Frame-Options strict on the API while leaving the web app
# permissive enough for embeds / Clerk popups.
(common_security_headers) {
  header {
    # Lock down powerful browser features we never use.
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Send the origin (not full URL) on cross-origin navigations to limit
    # referrer leakage while keeping analytics usable.
    Referrer-Policy "strict-origin-when-cross-origin"
    # Remove Caddy's default Server banner to reduce fingerprinting.
    -Server
  }
}

# Apex is short-link redirector only. Everything that isn't a short code
# permanently redirects to the app subdomain (the canonical web frontend).
{$DOMAIN:orangeurl.live}, www.{$DOMAIN:orangeurl.live} {
  encode gzip zstd
  import common_security_headers

  # Short codes: 2-16 alphanumeric + dot/dash/underscore.
  # If the API doesn't know the code, treat the path as a normal page
  # request and 301 to the app subdomain (e.g. /about → app/about).
  @shortcode path_regexp shortlink ^/[a-zA-Z0-9._-]{2,16}$
  handle @shortcode {
    reverse_proxy api:3000 {
      @api404 status 404
      handle_response @api404 {
        redir https://app.{$DOMAIN:orangeurl.live}{uri} 301
      }
    }
  }

  # Everything else (incl. apex /) → app subdomain.
  handle {
    redir https://app.{$DOMAIN:orangeurl.live}{uri} 301
  }

  log {
    output stdout
    format console
  }
}

# Dashboard / web app
# Note: X-Frame-Options is intentionally NOT set to DENY here — Next.js
# handles its own frame policy (SAMEORIGIN) via next.config.js to allow
# Clerk / payment iframes to function correctly.
app.{$DOMAIN:orangeurl.live} {
  encode gzip zstd
  import common_security_headers

  # Reject oversized request bodies before they reach the app.
  request_body {
    max_size 1MB
  }

  reverse_proxy web:3000

  log {
    output stdout
    format console
  }
}

# Go API
api.{$DOMAIN:orangeurl.live} {
  encode gzip zstd
  import common_security_headers

  # The API never renders HTML — forbid framing entirely.
  header X-Frame-Options "DENY"

  # Reject oversized request bodies before they hit the API (defense in depth;
  # Fiber also enforces a 1MB BodyLimit).
  request_body {
    max_size 1MB
  }

  reverse_proxy api:3000

  log {
    output stdout
    format console
  }
}
