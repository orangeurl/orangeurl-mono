{
  email {$ACME_EMAIL:admin@orangeurl.live}
}

# Short-link apex domain. Short-code paths hit the Go API which 301s to the long URL.
# Anything else (including reserved web paths) falls through to the Next.js frontend.
{$DOMAIN:orangeurl.live}, www.{$DOMAIN:orangeurl.live} {
  encode gzip zstd

  # Reserved web paths that look like short codes but must stay on the frontend.
  @webreserved path /about /pricing /contact /privacy /terms /blog /docs /sign-in /sign-up /dashboard /api-keys /settings /broken-link /bitly-alternative /tinyurl-alternative /rebrandly-alternative /home /bitly /compare-bitly /vs-bitly /robots.txt /sitemap.xml /favicon.ico /manifest.json /apple-touch-icon.png /favicon.svg
  handle @webreserved {
    reverse_proxy web:3000
  }

  # Short codes: 2-16 alphanumeric + dot/dash/underscore.
  @shortcode path_regexp shortlink ^/[a-zA-Z0-9._-]{2,16}$
  handle @shortcode {
    reverse_proxy api:3000
  }

  handle {
    reverse_proxy web:3000
  }

  log {
    output stdout
    format console
  }
}

# Dashboard / web app
app.{$DOMAIN:orangeurl.live} {
  encode gzip zstd
  reverse_proxy web:3000

  log {
    output stdout
    format console
  }
}

# Go API
api.{$DOMAIN:orangeurl.live} {
  encode gzip zstd
  reverse_proxy api:3000

  log {
    output stdout
    format console
  }
}
