{
  email {$ACME_EMAIL:admin@orangeurl.live}
}

# Apex is short-link redirector only. Everything that isn't a short code
# permanently redirects to the app subdomain (the canonical web frontend).
{$DOMAIN:orangeurl.live}, www.{$DOMAIN:orangeurl.live} {
  encode gzip zstd

  # Short codes: 2-16 alphanumeric + dot/dash/underscore.
  @shortcode path_regexp shortlink ^/[a-zA-Z0-9._-]{2,16}$
  handle @shortcode {
    reverse_proxy api:3000
  }

  # Everything else → app subdomain.
  redir https://app.{$DOMAIN:orangeurl.live}{uri} 301

  log {
    output stdout
    format console
  }
}

# Dashboard / web app
app.{$DOMAIN:orangeurl.live} {
  encode gzip zstd
  reverse_proxy web:3000

  log {
    output stdout
    format console
  }
}

# Go API
api.{$DOMAIN:orangeurl.live} {
  encode gzip zstd
  reverse_proxy api:3000

  log {
    output stdout
    format console
  }
}
